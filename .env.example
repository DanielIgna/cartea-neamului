# Lasă gol pentru baza de date locală (PGlite, în ./.data/pg).
# Cu Neon nu completezi nimic de mână: `npx neon@latest env pull` (sau `neon deploy`) scrie în .env.local
# DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_REALTIME_URL, NEON_REALTIME_SECRET, AWS_* (bucket „assets”),
# NEON_FUNCTION_HELLO_BASE_URL și, pe planurile plătite, NEON_AI_GATEWAY_BASE_URL / NEON_AI_GATEWAY_TOKEN.
DATABASE_URL=

# Cheie secretă pentru sesiuni (obligatorie în producție). Generează: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Adresa publică a aplicației, ex. https://cartea-neamului.vercel.app
BETTER_AUTH_URL=

# Opțional: modelul din catalogul Neon AI Gateway pentru sugestiile de biografie (implicit claude-haiku-4-5)
AI_MODEL=

# Pe Vercel numele AWS_* sunt rezervate: cheile bucket-ului se pun ca NEON_STORAGE_ACCESS_KEY_ID,
# NEON_STORAGE_SECRET_ACCESS_KEY, NEON_STORAGE_ENDPOINT_URL_S3 și NEON_STORAGE_REGION.

# Opțional: „Continuă cu Google” la intrare (și poza din contul Google lângă nume). Din Google Cloud Console → Credentials →
# OAuth client ID (Web application), cu adresa de întoarcere https://<domeniul tău>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cine intră în panoul de admin (/admin): adresele de email, despărțite prin virgulă. Fără ea nu e nimeni admin.
ADMIN_EMAILS=
